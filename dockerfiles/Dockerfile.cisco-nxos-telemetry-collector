FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go.mod and go.sum from collector directory
COPY telemetry/cisco/nx-os/collector/go.mod telemetry/cisco/nx-os/collector/go.sum ./
RUN go mod download

# Copy all source files including generated protobuf subpackages
COPY telemetry/cisco/nx-os/collector/ ./

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /collector main.go


FROM alpine:latest

WORKDIR /app

COPY --from=builder /collector .

EXPOSE 1164

CMD ["./collector"]