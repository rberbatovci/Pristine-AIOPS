FROM golang:1.23-alpine AS builder

WORKDIR /app/telemetry/cpu-util-stats

COPY telemetry/cpu-util-stats/go.mod telemetry/cpu-util-stats/go.sum ./

COPY telemetry/protobuf /app/telemetry/protobuf

COPY telemetry/cpu-util-stats/. .

RUN go mod download

RUN go get github.com/redis/go-redis/v9

# Build your binary
RUN go build -o consumer main.go

FROM alpine:3.18

WORKDIR /app/telemetry/cpu-util-stats

COPY --from=builder /app/telemetry/cpu-util-stats/consumer .

RUN apk add --no-cache bash

CMD ["./consumer"]
