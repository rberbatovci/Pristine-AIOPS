[global.config]
  as = ${BGP_AS_NUMBER}
  router-id = "${BGP_ROUTER_ID}"
  port = 179

[[neighbors]]
  [neighbors.config]
    neighbor-address = "${BGP_NEIGHBOR_IP}"
    peer-as = ${BGP_NEIGHBOR_AS}

  [neighbors.transport.config]
    passive-mode = true
    local-address = "${BGP_ROUTER_ID}"

  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ls"
      enabled = true
